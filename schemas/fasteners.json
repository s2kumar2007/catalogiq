{
  "category": "fasteners",
  "displayName": "Fasteners (Bolts, Nuts, Screws)",
  "description": "Threaded mechanical fasteners used to join or secure components",
  "fields": [
    {
      "key": "product_name",
      "label": "Product Name",
      "type": "string",
      "required": true,
      "validation": null
    },
    {
      "key": "fastener_type",
      "label": "Fastener Type",
      "type": "enum",
      "required": true,
      "validation": {
        "allowedValues": ["hex_bolt", "socket_head_cap_screw", "wing_nut", "hex_nut", "washer", "carriage_bolt", "self_tapping_screw", "eye_bolt"]
      }
    },
    {
      "key": "material",
      "label": "Material",
      "type": "enum",
      "required": true,
      "validation": {
        "allowedValues": ["stainless_steel_304", "stainless_steel_316", "carbon_steel", "brass", "titanium", "nylon", "alloy_steel"]
      }
    },
    {
      "key": "diameter_mm",
      "label": "Diameter",
      "type": "number",
      "unit": "mm",
      "required": true,
      "validation": {
        "min": 1,
        "max": 100,
        "note": "Standard metric fastener diameters range M1 to M100; flag anything outside typical M2-M64 as unusual"
      }
    },
    {
      "key": "length_mm",
      "label": "Length",
      "type": "number",
      "unit": "mm",
      "required": true,
      "validation": {
        "min": 3,
        "max": 500
      }
    },
    {
      "key": "thread_pitch_mm",
      "label": "Thread Pitch",
      "type": "number",
      "unit": "mm",
      "required": false,
      "validation": {
        "min": 0.25,
        "max": 6
      }
    },
    {
      "key": "tensile_strength_mpa",
      "label": "Tensile Strength",
      "type": "number",
      "unit": "MPa",
      "required": false,
      "validation": {
        "min": 200,
        "max": 1500,
        "note": "Grade 8.8 ~830 MPa, Grade 10.9 ~1040 MPa, Grade 12.9 ~1220 MPa - flag values outside these bands as inconsistent"
      }
    },
    {
      "key": "corrosion_resistance",
      "label": "Corrosion Resistance Rating",
      "type": "enum",
      "required": false,
      "validation": {
        "allowedValues": ["low", "medium", "high", "marine_grade"]
      }
    },
    {
      "key": "compliance_tags",
      "label": "Compliance / Standards",
      "type": "array",
      "required": false,
      "validation": {
        "allowedValues": ["ISO_4014", "DIN_931", "ASTM_A325", "RoHS", "REACH"]
      }
    }
  ],
  "crossFieldRules": [
    {
      "rule": "material_vs_corrosion",
      "description": "If material is stainless_steel_316, corrosion_resistance should be 'high' or 'marine_grade'. Flag mismatch.",
      "severity": "warning"
    },
    {
      "rule": "diameter_vs_length_ratio",
      "description": "Length should generally be at least 2x diameter and no more than 50x diameter for standard fasteners. Flag outliers as possibly misread specs.",
      "severity": "warning"
    },
    {
      "rule": "tensile_vs_material",
      "description": "Nylon fasteners should not report tensile_strength_mpa above 100 MPa. Flag as likely extraction error.",
      "severity": "error"
    }
  ]
}
